# Copie ce fichier vers scripts/.env et renseigne les vraies valeurs.
# scripts/.env est ignoré par git (voir .gitignore) — ne jamais le commiter.

# Même URL que VITE_SUPABASE_URL dans .env.local
SUPABASE_URL=

# Clé service_role (PAS la clé anon) — Supabase Dashboard > Project Settings
# > API > service_role secret. Contourne RLS : à garder strictement locale,
# jamais dans l'app cliente, jamais commitée.
SUPABASE_SERVICE_ROLE_KEY=
